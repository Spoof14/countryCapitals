# Copy to .env and fill in before shipping purchases.
# Never commit .env to git.

# ── RevenueCat (required for App Store / Play Store IAP) ─────────────────────
# 1. Create a project at https://app.revenuecat.com
# 2. Add iOS + Android apps (bundle id: com.madang.learnkorean)
# 3. Create entitlement `premium` and non-consumable product `madang_full_unlock` ($4.99)
# 4. Link App Store Connect + Google Play products in RevenueCat
# 5. Paste public API keys below
VITE_REVENUECAT_APPLE_API_KEY=
VITE_REVENUECAT_GOOGLE_API_KEY=

# ── Web checkout (optional) ───────────────────────────────────────────────────
# Stripe Payment Link for $5 one-time unlock on the website.
# For automatic unlock after payment, add a webhook or use RevenueCat web billing.
VITE_STRIPE_PAYMENT_LINK=

# ── Mobile build commands ─────────────────────────────────────────────────────
# yarn build:mobile && yarn cap:sync
# yarn cap:android   # opens Android Studio
# yarn cap:ios       # opens Xcode (macOS only)
